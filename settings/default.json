{
  "permissions": {
    "allow": [
      "WebSearch"
    ]
  },
  "skipWebFetchPreflight": true,
  "disableAgentView": true,
  "autoMemoryEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
